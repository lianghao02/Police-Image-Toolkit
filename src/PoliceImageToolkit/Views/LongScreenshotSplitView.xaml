<UserControl x:Class="PoliceImageToolkit.Views.LongScreenshotSplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:PoliceImageToolkit.Models"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100"
             Loaded="UserControl_Loaded"
             SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>
        <DropShadowEffect x:Key="DropShadowPhone" BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.25"/>
    </UserControl.Resources>

    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 頂部功能條 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📱 手機長截圖分頁輔助" Style="{StaticResource Heading2TextStyle}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HelperTextStyle}" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📂 載入長截圖" Command="{Binding OpenImageCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="32" Padding="14,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主體內容：左右等寬分欄 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左側：手機外框與捲動長圖預覽 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" Padding="12"
                    AllowDrop="True" DragEnter="PreviewDrop_DragEnter" DragOver="PreviewDrop_DragOver" Drop="PreviewDrop_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="4,0,4,10">
                        <Grid>
                            <TextBlock Text="手機預覽視窗（支援滑鼠滾輪、按住拖曳或 ↑／↓ 瀏覽）" Style="{StaticResource Heading3TextStyle}"/>
                            <TextBlock Text="{Binding SourceDimensions}" Style="{StaticResource HelperTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- 低解析度提醒卡片 -->
                        <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0"
                                Visibility="{Binding HasLowResolutionWarning, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LowResolutionWarningMessage}" Style="{StaticResource HelperTextStyle}" Foreground="#92400E" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 手機實體造型外框 -->
                    <Border Grid.Row="1" MaxWidth="440" HorizontalAlignment="Center" Background="#111827"
                            BorderBrush="{StaticResource PhoneFrameColor}" BorderThickness="6" CornerRadius="30"
                            ClipToBounds="True" Effect="{StaticResource DropShadowPhone}">
                        <Grid>
                            <ScrollViewer x:Name="LongImageScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="True" PreviewMouseLeftButtonDown="LongImageScroll_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="LongImageScroll_PreviewMouseMove" PreviewMouseLeftButtonUp="LongImageScroll_PreviewMouseLeftButtonUp"
                                          PreviewMouseWheel="LongImageScroll_PreviewMouseWheel" PreviewKeyDown="LongImageScroll_PreviewKeyDown">
                                <Grid x:Name="PreviewHost">
                                    <Image x:Name="LongPreviewImage" Source="{Binding SourceImage}" Stretch="Uniform"/>
                                    <Canvas x:Name="SplitOverlay" IsHitTestVisible="False"/>
                                </Grid>
                            </ScrollViewer>

                            <!-- 未載入時的待機畫面 -->
                            <Grid Visibility="{Binding SourceImage, Converter={StaticResource NullToVisConverter}}">
                                <Border Background="#1E2633" Opacity="0.96"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                    <Border Width="64" Height="64" CornerRadius="32" Background="#2A3546" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <TextBlock Text="📱" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="長截圖裁切工作台" Style="{StaticResource Heading3TextStyle}" Foreground="#F1F5F9" HorizontalAlignment="Center"/>
                                    <TextBlock Text="點擊右上角載入，或將 PNG / JPG 圖片直接拖曳至此處。"
                                               Style="{StaticResource HelperTextStyle}" Foreground="#94A3B8" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="280" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 底部提示列 -->
                    <Grid Grid.Row="2" Margin="6,10,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PageSummary}" Style="{StaticResource HelperTextStyle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="12" Height="12" Background="#FFFBEB" BorderBrush="#FBBF24" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="黃色虛線遮罩：前後頁固定重疊區（不重複計入公文本文）" Style="{StaticResource HelperTextStyle}" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右側：設定與輸出控制 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 卡片 1：檔案與輸出設定 -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="📁 檔案與輸出設定" Style="{StaticResource Heading3TextStyle}" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="📍 變更輸出目錄" Command="{Binding BrowseOutputDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="📂 開啟輸出資料夾" Command="{Binding OpenOutputDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </WrapPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="檔名前綴（選填）：" Style="{StaticResource FormLabelTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding FileNamePrefix, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" ToolTip="留白預設輸出 001.png、002.png；填寫後如 A113_001.png。"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 卡片 2：Word 報告書圖框比例與重疊設定 -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="⚙️ 報告書圖框規格與重疊設定" Style="{StaticResource Heading3TextStyle}" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 寬度 -->
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="圖框寬度 (cm)" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox Text="{Binding FrameWidthCm, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- 高度 -->
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="圖框高度 (cm)" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox Text="{Binding FrameHeightCm, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- 重疊量 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="重疊高度 (mm)" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox Text="{Binding OverlapMm, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="💡 提示：公務報告書標準推薦寬 8 cm、高 17.5 cm，預設重疊 5 mm 保障對話連續性。"
                                   Style="{StaticResource HelperTextStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 卡片 3：分頁預覽清單 -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="📄 分頁切分預覽清單" Style="{StaticResource Heading3TextStyle}" Margin="2,2,0,8"/>
                        <ListView Grid.Row="1" ItemsSource="{Binding Pages}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderColorLight}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Padding" Value="6,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#E2E8F0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:LongScreenshotPage}">
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding PageNumber, StringFormat=第 {0} 頁}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayRange}" Style="{StaticResource HelperTextStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding DisplayOverlap}" Style="{StaticResource HelperTextStyle}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{StaticResource BgSecondary}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="PNG" Foreground="{StaticResource AccentPrimary}" FontWeight="Bold" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- 底部匯出大按鈕 -->
                <Button Grid.Row="3" Content="📤 匯出全部分頁截圖 (PNG)" Command="{Binding ExportAllCommand}"
                        Style="{StaticResource SuccessButtonStyle}" Height="38" FontSize="13" FontWeight="Bold" Margin="0,10,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
