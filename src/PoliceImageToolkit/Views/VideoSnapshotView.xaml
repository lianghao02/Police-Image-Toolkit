<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PoliceImageToolkit.Views.VideoSnapshotView" AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver" Unloaded="UserControl_Unloaded">
  <Grid Margin="16,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="開啟手機錄影" Command="{Binding OpenVideoCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
      <StackPanel>
        <TextBlock Text="手機錄影截圖" Style="{StaticResource Heading2TextStyle}"/>
        <TextBlock Text="{Binding VideoTitle}" Style="{StaticResource HelperTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding VideoPath}"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="350"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardBorderStyle}" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Viewbox MaxWidth="460" MaxHeight="730" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0">
            <Grid Width="340" Height="540">
              <Border Background="{StaticResource PhoneFrameColor}" CornerRadius="30" Padding="7">
                <Border Background="#152235" CornerRadius="23" ClipToBounds="True">
                  <Grid>
                    <Image x:Name="PlayerDisplay" Stretch="Uniform"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="{Binding HasVideoLoaded, Converter={StaticResource InverseBoolToVisConverter}}">
                      <TextBlock Text="拖入手機螢幕錄影，或選擇「開啟手機錄影」" Foreground="White" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"/>
                      <TextBlock Text="逐張擷取手機畫面，對照上一張底部文字，避免漏截。" Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border x:Name="FlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False"/>
                  </Grid>
                </Border>
              </Border>
            </Grid>
          </Viewbox>
          <Grid Grid.Row="1" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding FormattedPosition}" FontFamily="{StaticResource NumberFont}" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Value="{Binding CurrentPositionSeconds, Mode=TwoWay}" Maximum="{Binding DurationSeconds}" Margin="12,0" AutomationProperties.Name="影片播放位置" IsMoveToPointEnabled="True" IsEnabled="{Binding HasVideoLoaded}" PreviewMouseDown="Slider_PreviewMouseDown" PreviewMouseUp="Slider_PreviewMouseUp"/>
            <TextBlock Grid.Column="2" Text="{Binding FormattedDuration}" VerticalAlignment="Center" FontFamily="{StaticResource NumberFont}"/>
          </Grid>
          <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="BtnPlayPause" Content="播放" Command="{Binding PlayPauseCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6" ToolTip="播放／暫停（P）"/>
            <Button Content="−1 秒" Command="{Binding StepBackward1sCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
            <Button Content="−0.1 秒" Command="{Binding StepBackwardCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
            <Button Content="+0.1 秒" Command="{Binding StepForwardCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
            <Button Content="+1 秒" Command="{Binding StepForward1sCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6"/>
          </WrapPanel>
          <StackPanel Grid.Row="3">
            <Button Content="儲存目前畫面（Space）" Command="{Binding CaptureSnapshotCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="44"/>
            <TextBlock Text="← → 移動 0.1 秒 · ↑ ↓ 移動 1 秒 · P 播放／暫停" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="時間為播放器回報位置，非逐影格精確時間；輸入文字時不啟用快捷鍵。" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock Text="定位中，畫面穩定後即可截圖…" Foreground="{StaticResource AccentPrimary}" Visibility="{Binding IsSeeking, Converter={StaticResource BoolToVisConverter}}"/>
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="{Binding ComparisonTitle}" Style="{StaticResource Heading3TextStyle}"/>
              <TextBlock Text="{Binding ComparisonSource}" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap" Margin="0,4,0,4" ToolTip="{Binding LastCapturedSnapshot.SourceFilePath}"/><TextBlock Text="用於人工比對是否漏截；請確認重疊內容。" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap" Margin="0,4,0,8"/>
              <Border Background="{StaticResource BgInset}" CornerRadius="6" Height="150">
                <Grid>
                  <Image Source="{Binding LastCapturedSnapshot.BottomStrip}" Stretch="Uniform"/>
                  <TextBlock Text="儲存第一張截圖後顯示" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasLastCapturedSnapshot, Converter={StaticResource InverseBoolToVisConverter}}"/>
                </Grid>
              </Border>
              <Button Content="放大上一張截圖" Click="OpenLastSnapshot_Click" IsEnabled="{Binding HasLastCapturedSnapshot}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0"/>
            <Button Content="不使用上段對照" Command="{Binding ClearPreviousComparisonCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,6,0,0" Visibility="{Binding IsPreviousSegmentComparison, Converter={StaticResource BoolToVisConverter}}"/></StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel IsEnabled="{Binding CanEditSettings}">
              <TextBlock Text="截圖設定" Style="{StaticResource Heading3TextStyle}" Margin="0,0,0,10"/>
              <Label Content="檔名前綴（選填）" Target="{Binding ElementName=PrefixInput}" Padding="0,0,0,4"/>
              <TextBox x:Name="PrefixInput" Text="{Binding CasePrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="檔名前綴"/>
              <TextBlock Text="新影片前綴預設留白，使用 001.png、002.png；格式與品質沿用。" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap" Margin="0,4,0,10"/>
              <Label Content="輸出格式" Target="{Binding ElementName=FormatInput}" Padding="0,0,0,4"/>
              <ComboBox x:Name="FormatInput" SelectedValuePath="Content" SelectedValue="{Binding OutputFormat}" AutomationProperties.Name="截圖輸出格式">
                <ComboBoxItem Content="PNG"/>
                <ComboBoxItem Content="JPG"/>
              </ComboBox>
              <StackPanel Margin="0,8,0,0" Visibility="{Binding OutputFormat, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=JPG}">
                <TextBlock Text="{Binding JpgQuality, StringFormat=JPG 品質：{0}}"/>
                <Slider Value="{Binding JpgQuality}" Minimum="10" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="JPG 壓縮品質"/>
                <TextBlock Text="數值越高，壓縮越少；不是畫質保留百分比。" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap"/>
              </StackPanel>
              <CheckBox Content="在圖片加上影片時間與檔名" IsChecked="{Binding AddTimestampOverlay}" Margin="0,12,0,6"/>
              <CheckBox Content="顯示毫秒" IsChecked="{Binding IncludeMilliseconds}" Margin="20,0,0,6" Visibility="{Binding AddTimestampOverlay, Converter={StaticResource BoolToVisConverter}}"/>
              <TextBlock Text="浮水印會改變輸出圖片；原始影片保持不變。" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Text="{Binding Snapshots.Count, StringFormat=本段截圖（{0} 張）}" Style="{StaticResource Heading3TextStyle}"/>
              <TextBlock Text="僅顯示目前影片；換回先前影片可查看其清單。" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap" Margin="0,4,0,8"/>
              <ListView ItemsSource="{Binding Snapshots}" Height="210" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource GameListItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding FilePath, Converter={StaticResource FileNameFromPathConverter}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                      <TextBlock Text="{Binding SourceFilePath, Converter={StaticResource FileNameFromPathConverter}}" Style="{StaticResource HelperTextStyle}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Timestamp, StringFormat=影片位置 {0:hh\\:mm\\:ss\\.fff}}" Style="{StaticResource HelperTextStyle}"/>
                      <TextBlock>
                        <Run Text="{Binding Width}"/>
                        <Run Text=" × "/>
                        <Run Text="{Binding Height}"/>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <Button Content="本段最新一張移至回收區（Z）" Command="{Binding UndoLastCaptureCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,6"/>
              <Button Content="還原本段最近移除" Command="{Binding RestoreLastRemovedCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" ToolTip="只還原目前影片移至回收區的最新一張截圖；不覆寫同名檔"/>
              <WrapPanel>
                <Button Content="移除本段清單" Command="{Binding ClearSnapshotsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" ToolTip="保留已儲存的檔案"/>
                <Button Content="本段全部移至回收區…" Command="{Binding DeleteSnapshotFilesCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,6"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" Padding="12">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
            <Button Content="變更位置" Command="{Binding BrowseOutputDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
            <Button Content="開啟資料夾" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="本段儲存位置" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding EffectiveOutputDirectory}" TextWrapping="Wrap" ToolTip="{Binding EffectiveOutputDirectory}"/>
          </StackPanel>
        </DockPanel>
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <DockPanel Margin="0,6,0,0">
          <Button DockPanel.Dock="Right" Content="重試來源紀錄" Command="{Binding RetryIndexCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
          <TextBlock Text="{Binding IndexMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
