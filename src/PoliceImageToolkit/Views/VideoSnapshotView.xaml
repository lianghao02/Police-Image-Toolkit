<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PoliceImageToolkit.Views.VideoSnapshotView" AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver" Unloaded="UserControl_Unloaded" Focusable="True">
  <Grid Margin="14,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 頂部工具列卡片 -->
    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,8" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding VideoTitle}" Style="{StaticResource Heading2TextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding VideoPath}"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding HasMultipleSegments, Converter={StaticResource BoolToVisConverter}}">
          <TextBlock Text="切換分段：" Style="{StaticResource HelperTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox ItemsSource="{Binding OpenedSegments}" DisplayMemberPath="FileName" SelectedValuePath="FilePath" SelectedValue="{Binding SelectedSegmentPath, Mode=TwoWay}" Width="180" Height="30" AutomationProperties.Name="切換已開啟的錄影分段"/>
        </StackPanel>
        <Button Grid.Column="2" Content="開啟手機錄影" Command="{Binding OpenVideoCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
      </Grid>
    </Border>

    <!-- 中間工作台：雙直式對照舞台 + 右側設定與清單 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="312"/>
      </Grid.ColumnDefinitions>

      <!-- 左側主舞台卡片 -->
      <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- 雙直式並排預覽區 -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左框：目前影片畫面 -->
            <Grid Grid.Column="0" Background="Transparent" PreviewMouseWheel="PhonePreviewBox_PreviewMouseWheel" ToolTip="支援滑鼠滾輪微調（向上 +0.1 秒、向下 −0.1 秒；按住 Shift 為 0.5 秒）">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right" Text="定位中…" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center" Visibility="{Binding IsSeeking, Converter={StaticResource BoolToVisConverter}}"/>
                <TextBlock Text="目前影片畫面" Style="{StaticResource FormLabelTextStyle}" VerticalAlignment="Center"/>
              </DockPanel>
              <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="310" Height="590">
                  <Border Background="{StaticResource PhoneFrameColor}" CornerRadius="20" Padding="6">
                    <Border Background="{StaticResource PhoneScreenColor}" CornerRadius="14" ClipToBounds="True">
                      <Grid>
                        <Image x:Name="PlayerDisplay" Stretch="Uniform" Visibility="{Binding HasVideoLoaded, Converter={StaticResource BoolToVisConverter}}"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22" Visibility="{Binding HasVideoLoaded, Converter={StaticResource InverseBoolToVisConverter}}">
                          <Border Background="#1E293B" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="手機螢幕錄影" FontSize="12.5" FontWeight="Bold" Foreground="#93C5FD"/>
                          </Border>
                          <TextBlock Text="拖入錄影檔案，或按右上角「開啟手機錄影」" Foreground="White" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
                          <TextBlock Text="支援播放與 0.1／0.5／1 秒微調，搭配右側上一張畫面確認接縫" Foreground="{StaticResource TextOnDarkSecondary}" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                        <Border x:Name="FlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False"/>
                      </Grid>
                    </Border>
                  </Border>
                </Grid>
              </Viewbox>
            </Grid>

            <!-- 右框：上一張截圖（或清單選取）並排對照 -->
            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="原圖" Click="OpenLastSnapshot_Click" IsEnabled="{Binding HasActiveComparisonSnapshot}" Style="{StaticResource CompactButtonStyle}" Height="26" Padding="10,0" ToolTip="開啟可縮放的獨立對照視窗（不鎖定主畫面）"/>
                <TextBlock Text="{Binding ComparisonTitle}" Style="{StaticResource FormLabelTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
              </DockPanel>

              <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ComparisonSource}" Style="{StaticResource HelperTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" ToolTip="{Binding ActiveComparisonSnapshot.FilePath}" Visibility="{Binding ComparisonSource, Converter={StaticResource StringNotEmptyToVisConverter}}"/>
                <Button Grid.Column="1" Content="切回最新" Command="{Binding ClearInspectionCommand}" Style="{StaticResource CompactButtonStyle}" Height="24" Padding="6,0" Margin="0,0,4,0" Visibility="{Binding IsInspectingSelectedSnapshot, Converter={StaticResource BoolToVisConverter}}"/>
                <Button Grid.Column="2" Content="關閉" Command="{Binding ClearPreviousComparisonCommand}" Style="{StaticResource CompactButtonStyle}" Height="24" Padding="6,0" Margin="0,0,4,0" Visibility="{Binding IsPreviousSegmentComparison, Converter={StaticResource BoolToVisConverter}}" ToolTip="關閉上一段參考對照"/>
                <Border Grid.Column="3" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderColorLight}" BorderThickness="1" CornerRadius="6" Padding="2">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Content="整張" GroupName="CompareMode" IsChecked="{Binding ComparisonViewMode, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=Full, Mode=OneWay}" Command="{Binding SetComparisonModeCommand}" CommandParameter="Full" Style="{StaticResource SegmentedRadioStyle}" Padding="7,3"/>
                    <RadioButton Content="底部" GroupName="CompareMode" IsChecked="{Binding ComparisonViewMode, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=Bottom, Mode=OneWay}" Command="{Binding SetComparisonModeCommand}" CommandParameter="Bottom" Style="{StaticResource SegmentedRadioStyle}" Padding="7,3" ToolTip="放大顯示截圖底部 1/3（向下捲動對照）"/>
                    <RadioButton Content="頂部" GroupName="CompareMode" IsChecked="{Binding ComparisonViewMode, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=Top, Mode=OneWay}" Command="{Binding SetComparisonModeCommand}" CommandParameter="Top" Style="{StaticResource SegmentedRadioStyle}" Padding="7,3" ToolTip="放大顯示截圖頂部 1/3（向上捲動對照）"/>
                  </StackPanel>
                </Border>
              </Grid>

              <Viewbox Grid.Row="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="310" Height="590">
                  <Border Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderColorLight}" BorderThickness="1" CornerRadius="16" Padding="6">
                    <Border Background="White" CornerRadius="11" ClipToBounds="True">
                      <Grid>
                        <Image Source="{Binding ActiveComparisonImage}" Stretch="Uniform" Visibility="{Binding HasActiveComparisonSnapshot, Converter={StaticResource BoolToVisConverter}}"/>
                        <Border Background="#CC0F172A" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" IsHitTestVisible="False" Visibility="{Binding HasComparisonZoomHint, Converter={StaticResource BoolToVisConverter}}">
                          <TextBlock Text="{Binding ComparisonZoomHint}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding HasActiveComparisonSnapshot, Converter={StaticResource InverseBoolToVisConverter}}">
                          <TextBlock Text="尚無上一張截圖" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" TextAlignment="Center"/>
                          <TextBlock Text="擷取第一張畫面後將顯示於此&#10;方便與左側目前影片並排對照" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Border>
                </Grid>
              </Viewbox>
            </Grid>
          </Grid>

          <!-- 時間軸 -->
          <Grid Grid.Row="1" Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding FormattedPosition}" FontFamily="{StaticResource NumberFont}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Slider x:Name="TimelineSlider" Grid.Column="1" Value="{Binding CurrentPositionSeconds, Mode=TwoWay}" Maximum="{Binding SliderMaximum}" Margin="12,0" AutomationProperties.Name="影片播放位置" IsMoveToPointEnabled="True" IsEnabled="{Binding HasVideoLoaded}" PreviewMouseDown="Slider_PreviewMouseDown" PreviewMouseUp="Slider_PreviewMouseUp" LostMouseCapture="Slider_LostMouseCapture"/>
            <TextBlock Grid.Column="2" Text="{Binding FormattedDuration}" FontFamily="{StaticResource NumberFont}" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
          </Grid>

          <!-- 四段播放與微調按鈕 -->
          <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Button Content="−1 秒" Command="{Binding StepBackward1sCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="11,0" Margin="0,0,6,4" ToolTip="往回 1 秒（↓ 或 S）"/>
            <Button Content="−0.5 秒" Command="{Binding StepBackwardHalfCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="11,0" Margin="0,0,6,4" ToolTip="往回 0.5 秒（Shift + ←）"/>
            <Button Content="−0.1 秒" Command="{Binding StepBackwardCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="11,0" Margin="0,0,8,4" ToolTip="往回 0.1 秒（← 或 A）"/>
            <Button x:Name="BtnPlayPause" Content="播放" Command="{Binding PlayPauseCommand}" Style="{StaticResource GoldButtonStyle}" Height="32" MinWidth="78" Padding="12,0" Margin="0,0,6,4" ToolTip="播放／暫停（P）"/>
            <Button Content="{Binding PlaybackSpeedDisplay}" Command="{Binding CyclePlaybackSpeedCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" MinWidth="46" Padding="8,0" Margin="0,0,8,4" ToolTip="切換播放倍速（1x / 1.5x / 2x）"/>
            <Button Content="+0.1 秒" Command="{Binding StepForwardCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="11,0" Margin="0,0,6,4" ToolTip="前進 0.1 秒（→ 或 D）"/>
            <Button Content="+0.5 秒" Command="{Binding StepForwardHalfCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="11,0" Margin="0,0,6,4" ToolTip="前進 0.5 秒（Shift + →）"/>
            <Button Content="+1 秒" Command="{Binding StepForward1sCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="11,0" Margin="0,0,0,4" ToolTip="前進 1 秒（↑ 或 W）"/>
          </WrapPanel>

          <!-- 主截圖操作與即時回饋 -->
          <StackPanel Grid.Row="3">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="擷取目前畫面（Space）" Command="{Binding CaptureSnapshotCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="220" Height="40" FontSize="14.5"/>
              <Border Grid.Column="1" Background="{StaticResource BgInset}" CornerRadius="6" Padding="10,6" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HelperTextStyle}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>
              </Border>
            </Grid>
            <TextBlock Text="快捷鍵：← →／滾輪 0.1 秒 · Shift+← → 0.5 秒 · ↑ ↓ 1 秒 · P 播放／暫停 · Ctrl+Z 復原 · Esc 退出文字輸入" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 右側欄：截圖設定 + 彈性高度截圖清單 -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 截圖設定 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,10">
          <StackPanel IsEnabled="{Binding CanEditSettings}">
            <TextBlock Text="截圖設定" Style="{StaticResource Heading3TextStyle}" Margin="0,0,0,8"/>

            <TextBlock Text="檔名前綴（選填）" Style="{StaticResource FormLabelTextStyle}" Margin="0,0,0,4"/>
            <TextBox x:Name="PrefixInput" Text="{Binding CasePrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="檔名前綴"/>
            <TextBlock Text="留白時依 001、002 流水號命名（輸入後按 Esc 或 Enter 恢復快捷鍵）" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap" Margin="0,4,0,8"/>

            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Width="110">
                <TextBlock Text="輸出格式" Style="{StaticResource FormLabelTextStyle}" Margin="0,0,0,4"/>
                <ComboBox x:Name="FormatInput" SelectedValuePath="Content" SelectedValue="{Binding OutputFormat}" AutomationProperties.Name="截圖輸出格式">
                  <ComboBoxItem Content="PNG"/>
                  <ComboBoxItem Content="JPG"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2" Visibility="{Binding OutputFormat, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=JPG}">
                <TextBlock Text="{Binding JpgQuality, StringFormat=JPG 品質：{0}}" Style="{StaticResource FormLabelTextStyle}" Margin="0,0,0,4"/>
                <Slider Value="{Binding JpgQuality}" Minimum="10" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="JPG 壓縮品質"/>
              </StackPanel>
            </Grid>

            <CheckBox Content="圖片底部加上時間與檔名" IsChecked="{Binding AddTimestampOverlay}" Margin="0,4,0,4"/>
            <CheckBox Content="顯示毫秒" IsChecked="{Binding IncludeMilliseconds}" Margin="24,2,0,0" Visibility="{Binding AddTimestampOverlay, Converter={StaticResource BoolToVisConverter}}"/>
          </StackPanel>
        </Border>

        <!-- 截圖清單 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6">
              <TextBlock DockPanel.Dock="Right" Text="點選可於左側預覽" Style="{StaticResource HelperTextStyle}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Snapshots.Count, StringFormat=截圖清單（{0} 張）}" Style="{StaticResource Heading3TextStyle}" VerticalAlignment="Center"/>
            </DockPanel>

            <ListView Grid.Row="1" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource GameListItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="42"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="52" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderColorLight}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Center">
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,6,0">
                      <TextBlock Text="{Binding FilePath, Converter={StaticResource FileNameFromPathConverter}}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                      <TextBlock Text="{Binding Timestamp, StringFormat={}{0:hh\\:mm\\:ss\\.fff}}" Style="{StaticResource HelperTextStyle}"/>
                      <TextBlock Style="{StaticResource HelperTextStyle}">
                        <Run Text="{Binding Width}"/>
                        <Run Text=" × "/>
                        <Run Text="{Binding Height}"/>
                      </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Content="移除" Command="{Binding DataContext.RemoveSingleSnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource CompactDangerButtonStyle}" Padding="8,0" VerticalAlignment="Center" ToolTip="移至暫存回收區（可還原）"/>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="2" Margin="0,8,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Row="0" Grid.Column="0" Content="復原上一張 (Ctrl+Z)" Command="{Binding UndoLastCaptureCommand}" Style="{StaticResource CompactButtonStyle}" Height="32"/>
              <Button Grid.Row="0" Grid.Column="2" Content="還原最近移除" Command="{Binding RestoreLastRemovedCommand}" Style="{StaticResource CompactButtonStyle}" Height="32" ToolTip="還原最近移至暫存回收區的截圖（不覆寫同名檔）"/>
              <Button Grid.Row="2" Grid.Column="0" Content="清空清單" Command="{Binding ClearSnapshotsCommand}" Style="{StaticResource CompactButtonStyle}" Height="32" ToolTip="只清空畫面清單，磁碟檔案仍保留"/>
              <Button Grid.Row="2" Grid.Column="2" Content="全部移至回收區…" Command="{Binding DeleteSnapshotFilesCommand}" Style="{StaticResource DangerButtonStyle}" FontSize="12.5" Height="32" Padding="8,0"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- 底部儲存位置列 -->
    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12,8" Margin="0,10,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="重試來源紀錄" Command="{Binding RetryIndexCommand}" Style="{StaticResource DangerButtonStyle}" Height="30" FontSize="12.5" Padding="10,0" Margin="0,0,6,0" Visibility="{Binding HasPendingIndexWork, Converter={StaticResource BoolToVisConverter}}"/>
          <Button Content="開啟回收區" Command="{Binding OpenRecoveryFolderCommand}" Style="{StaticResource CompactButtonStyle}" Height="30" Margin="0,0,6,0" Visibility="{Binding HasRecoveryFiles, Converter={StaticResource BoolToVisConverter}}" ToolTip="開啟目前資料夾的暫存回收區"/>
          <Button Content="清空回收區" Command="{Binding EmptyRecoveryFolderCommand}" Style="{StaticResource CompactDangerButtonStyle}" Height="30" Margin="0,0,6,0" Visibility="{Binding HasRecoveryFiles, Converter={StaticResource BoolToVisConverter}}" ToolTip="永久刪除暫存回收區內的舊截圖檔（釋放硬碟空間）"/>
          <Button Content="變更位置" Command="{Binding BrowseOutputDirectoryCommand}" Style="{StaticResource CompactButtonStyle}" Height="30" Margin="0,0,6,0"/>
          <Button Content="開啟資料夾" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource CompactButtonStyle}" Height="30"/>
        </StackPanel>
        <DockPanel VerticalAlignment="Center">
          <TextBlock DockPanel.Dock="Left" Text="儲存位置：" Style="{StaticResource FormLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding IndexMessage, StringFormat=（{0}）}" Style="{StaticResource HelperTextStyle}" Foreground="{StaticResource AccentDangerHover}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding HasPendingIndexWork, Converter={StaticResource BoolToVisConverter}}"/>
          <TextBlock Text="{Binding EffectiveOutputDirectory}" Style="{StaticResource HelperTextStyle}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveOutputDirectory}"/>
        </DockPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
