<UserControl x:Class="PoliceImageToolkit.Views.VideoSnapshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:PoliceImageToolkit.Models"
             xmlns:services="clr-namespace:PoliceImageToolkit.Services"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100"
             AllowDrop="True"
             Loaded="UserControl_Loaded"
             SizeChanged="UserControl_SizeChanged"
             Drop="UserControl_Drop"
             DragOver="UserControl_DragOver">

    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 頂部功能條 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardTitleBadgeStyle}" Margin="0,0,14,0">
                    <TextBlock Text="🎬 手機影片逐格截圖" Style="{StaticResource Heading2TextStyle}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource HelperTextStyle}" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📂 開啟影片" Command="{Binding OpenVideoCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                            ToolTip="支援 MOV / MP4 / M4V / AVI / MKV / WEBM（依系統解碼器）"/>
                    <Button Content="📁 開啟截圖資料夾" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主體內容：左右等寬；左側優先保留手機影片辨識空間 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左側：手機圖框與播放容器 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Q 版手機外框：設計尺寸 340 × 540，依可用空間等比例縮放（上限 460 × 730） -->
                    <Viewbox Grid.Row="0" MaxWidth="460" MaxHeight="730" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="340" Height="540">
                            <!-- 機身厚底陰影 -->
                            <Border Margin="0,5,0,0" CornerRadius="30" Background="#1B1838"/>
                            <Border Margin="0,0,0,5" Background="{StaticResource PhoneScreenColor}" BorderBrush="{StaticResource PhoneFrameColor}" BorderThickness="7"
                                    CornerRadius="30" ClipToBounds="True">
                                <Grid>
                                    <!-- 影片播放器主畫面 -->
                                    <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                  ScrubbingEnabled="True" Stretch="Uniform"
                                                  MediaOpened="Player_MediaOpened"
                                                  MediaEnded="Player_MediaEnded"
                                                  MediaFailed="Player_MediaFailed"/>

                                    <!-- 未載入影片待機畫面 -->
                                    <Grid Panel.ZIndex="2" Visibility="{Binding HasVideoLoaded, Converter={StaticResource InverseBoolToVisConverter}}">
                                        <Border Background="{StaticResource Ink}"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                            <Grid Width="68" Height="68" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <Ellipse Fill="{StaticResource GoldChin}" Stroke="#1B1838" StrokeThickness="3" Margin="0,5,0,0"/>
                                                <Ellipse Fill="{StaticResource GoldFace}" Stroke="#1B1838" StrokeThickness="3" Margin="0,0,0,5"/>
                                                <TextBlock Text="🎬" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5"/>
                                            </Grid>
                                            <TextBlock Text="手機對話錄影工作台"
                                                       FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextOnDark}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="將手機側錄 (MOV / MP4) 拖曳至此處"
                                                       FontSize="13" Foreground="{StaticResource TextOnDarkSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center"/>
                                            <Border Height="3" CornerRadius="1.5" Background="#4A4378" Margin="16,14,16,14"/>
                                            <Border Background="#1B1838" BorderBrush="{StaticResource GoldFace}" BorderThickness="2" CornerRadius="12" Padding="14,10">
                                                <TextBlock Text="• [ 空白鍵 Space ] 擷取當前頁&#x0a;• [ ← / → ] 0.1 秒逐格微調&#x0a;• [ ↑ / ↓ ] 1 秒快速跳轉&#x0a;• [ Z 鍵 ] 復原 / 刪除上一頁&#x0a;• [ P / Enter ] 播放 / 暫停"
                                                           FontSize="13" Foreground="{StaticResource TextOnDark}" LineHeight="22"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 快門白色閃爍回饋圖層 -->
                                    <Border x:Name="FlashOverlay" Background="White" Opacity="0" Panel.ZIndex="20" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Viewbox>

                    <!-- 時間滑桿與時間戳顯示 -->
                    <Grid Grid.Row="1" Margin="4,12,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PillBadgeStyle}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding FormattedPosition}" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" FontFamily="{StaticResource NumberFont}" FontSize="13"/>
                        </Border>
                        <Slider Grid.Column="1" Value="{Binding CurrentPositionSeconds, Mode=TwoWay}" Maximum="{Binding DurationSeconds}"
                                IsMoveToPointEnabled="True" VerticalAlignment="Center" Focusable="False"
                                IsEnabled="{Binding HasVideoLoaded}"
                                PreviewMouseDown="Slider_PreviewMouseDown"
                                PreviewMouseUp="Slider_PreviewMouseUp"/>
                        <TextBlock Grid.Column="2" Text="{Binding FormattedDuration}" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource NumberFont}" FontSize="13"/>
                    </Grid>

                    <!-- 播放與逐格工具列 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Button x:Name="BtnPlayPause" Content="▶ 播放" Command="{Binding PlayPauseCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                Width="84" Padding="4,0" Margin="0,0,6,0" ToolTip="播放 / 暫停 (P / Enter 鍵)"/>
                        <Button Content="-1s" Command="{Binding StepBackward1sCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="快退 1 秒 (↓ / S 鍵)" Margin="0,0,4,0" Width="52" Padding="2,0"/>
                        <Button Content="-0.1s" Command="{Binding StepBackwardCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="倒退 0.1 秒 (← / A 鍵)" Margin="0,0,4,0" Width="58" Padding="2,0"/>
                        <Button Content="+0.1s" Command="{Binding StepForwardCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="前進 0.1 秒 (→ / D 鍵)" Margin="0,0,4,0" Width="58" Padding="2,0"/>
                        <Button Content="+1s" Command="{Binding StepForward1sCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="快進 1 秒 (↑ / W 鍵)" Width="52" Padding="2,0"/>
                    </StackPanel>

                    <!-- 截圖大按鈕與快捷鍵提示 -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="← / → 0.1s ｜ Space 截圖 ｜ Z 復原" Style="{StaticResource HelperTextStyle}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,10,0"/>
                        <Button Grid.Column="1" Content="📸 擷取當前頁 (Space)" Command="{Binding CaptureSnapshotCommand}"
                                Style="{StaticResource SuccessButtonStyle}" Padding="18,0" Height="44" FontSize="15"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右側：寬螢幕時分為對照直欄與設定/清單直欄；窄螢幕回復上下堆疊 -->
            <ScrollViewer Grid.Column="1" x:Name="RightScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" SizeChanged="RightScroll_SizeChanged">
            <Grid x:Name="RightWorkspace">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 卡片 1：上頁末行對照 -->
                <Border x:Name="CompareCard" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,2">
                            <Border Style="{StaticResource CardTitleBadgeStyle}" Margin="0,0,8,6">
                                <TextBlock Text="🔄 上頁末行對照 (防漏截)" Style="{StaticResource Heading3TextStyle}"/>
                            </Border>
                            <Border Style="{StaticResource PillBadgeStyle}" Background="{StaticResource PillMint}" Margin="0,0,0,6"
                                    Visibility="{Binding HasLastCapturedSnapshot, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="{Binding LastCapturedSnapshot.Timestamp, StringFormat={}{0:hh\\:mm\\:ss\\.fff}}" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentSuccess}" FontFamily="{StaticResource NumberFont}"/>
                            </Border>
                        </WrapPanel>

                        <Border x:Name="ComparePreview" Grid.Row="1" MinHeight="300" Background="{StaticResource BgInset}" CornerRadius="12"
                                BorderBrush="{StaticResource Ink}" BorderThickness="2" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding LastCapturedSnapshot.Thumbnail}" Stretch="Uniform" Margin="2"
                                       Visibility="{Binding HasLastCapturedSnapshot, Converter={StaticResource BoolToVisConverter}}"/>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasLastCapturedSnapshot, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <TextBlock Text="🖼️" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="尚無對照圖" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="按 [ 空白鍵 Space ] 擷取第一頁" Style="{StaticResource HelperTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 卡片 2：快照設定 -->
                <Border x:Name="SettingsCard" Grid.Column="1" Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12">
                    <StackPanel>
                        <Border Style="{StaticResource CardTitleBadgeStyle}" Margin="0,0,0,10">
                            <TextBlock Text="⚙️ 快照與前綴標籤" Style="{StaticResource Heading3TextStyle}"/>
                        </Border>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="檔名前綴：" Style="{StaticResource FormLabelTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CasePrefix, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="6,0,0,0" ToolTip="選填，留白即以 001.png 命名"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="輸出格式：" Style="{StaticResource FormLabelTextStyle}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding OutputFormat}" Margin="6,0,0,0">
                                <ComboBoxItem Content="PNG" IsSelected="True"/>
                                <ComboBoxItem Content="JPG"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox IsChecked="{Binding AddTimestampOverlay}" Content="烙印時間戳記浮水印 (hh:mm:ss.fff)" Margin="0,2,0,6"/>
                        <TextBlock Text="每部影片會自動建立獨立 Snapshots 資料夾，檔名依 001、002… 排序。"
                                   Style="{StaticResource HelperTextStyle}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <Button Content="↩ 復原 / 刪除上一頁截圖 (Z)" Command="{Binding UndoLastCaptureCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Height="34" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- 卡片 3：已擷取證物清單 -->
                <Border x:Name="EvidenceCard" Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource CardBorderStyle}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                            <Border Style="{StaticResource CardTitleBadgeStyle}" Margin="0,0,10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 已擷取截圖" Style="{StaticResource Heading3TextStyle}"/>
                                    <TextBlock Text="{Binding Snapshots.Count, StringFormat={} ×{0}}" Style="{StaticResource Heading3TextStyle}" FontFamily="{StaticResource NumberFont}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="清空清單" Command="{Binding ClearSnapshotsCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,6,0" Padding="8,0" Height="30" FontSize="12" ToolTip="只移除本次介面清單，已儲存的截圖檔案會保留。"/>
                                <Button Content="刪除檔案..." Command="{Binding DeleteSnapshotFilesCommand}" Style="{StaticResource DangerButtonStyle}"
                                        Padding="8,0" Height="30" FontSize="12" ToolTip="刪除目前清單中的衍生截圖檔案，執行前會再次確認。"/>
                            </StackPanel>
                        </WrapPanel>

                        <ListView Grid.Row="1" ItemsSource="{Binding Snapshots}" Background="Transparent" BorderThickness="0" AlternationCount="2"
                                  ItemContainerStyle="{StaticResource GameListItemStyle}"
                                  Foreground="{StaticResource TextPrimary}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:SnapshotResult}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="38" Height="38" Background="{StaticResource TrackBackground}" BorderBrush="{StaticResource Ink}"
                                                BorderThickness="2" CornerRadius="8" ClipToBounds="True" Margin="0,0,6,0">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:hh\\:mm\\:ss\\.fff}}" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" FontSize="13" FontFamily="{StaticResource NumberFont}"/>
                                            <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" Background="{StaticResource PillMint}" Padding="6,1" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Width, StringFormat={}{0}p}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource NumberFont}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
