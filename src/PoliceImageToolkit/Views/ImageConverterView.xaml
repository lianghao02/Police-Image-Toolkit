<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:models="clr-namespace:PoliceImageToolkit.Models" x:Class="PoliceImageToolkit.Views.ImageConverterView" mc:Ignorable="d" d:DesignHeight="650" d:DesignWidth="900" AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
  <Grid Margin="14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!-- 頂部功能區 -->
    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="14,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardTitleBadgeStyle}" Margin="0,0,14,0">
          <TextBlock Text="圖片轉檔" Style="{StaticResource Heading2TextStyle}"/>
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding SummaryText}" ToolTip="{Binding SummaryText}" Style="{StaticResource HelperTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="加入圖片" Command="{Binding AddFilesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
          <Button Content="依設定重新轉檔" Command="{Binding ReconvertCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" ToolTip="將全部圖片依目前設定另存新檔，先前輸出會保留"/>
          <Button Content="移除全部項目" Command="{Binding ClearAllCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- 中間任務列表 / 拖曳提示區 -->
    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="10">
      <Grid>
        <!-- 當清單為空時顯示拖曳熱區 (Dropzone) -->
        <Grid Visibility="{Binding Tasks.Count, Converter={StaticResource CountToVisHiddenConverter}}">
          <Rectangle RadiusX="14" RadiusY="14" Fill="{StaticResource BgInset}" Stroke="{StaticResource Ink}" StrokeThickness="1" StrokeDashArray="4 3" SnapsToDevicePixels="True"/>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <Grid Width="78" Height="78" HorizontalAlignment="Center" Margin="0,0,0,14">
              <Ellipse Fill="{StaticResource GoldChin}" Stroke="{StaticResource Ink}" StrokeThickness="1" Margin="0,5,0,0"/>
              <Ellipse Fill="{StaticResource GoldFace}" Stroke="{StaticResource Ink}" StrokeThickness="1" Margin="0,0,0,5"/>
              <TextBlock Text="圖片" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5"/>
            </Grid>
            <TextBlock Text="將圖片或資料夾拖曳至此，或選擇「加入圖片」" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
            <TextBlock Text="加入後設定格式與尺寸，再按「開始轉檔」；原始檔案會保留" Style="{StaticResource HelperTextStyle}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,16"/>
            <!-- 支援格式標籤膠囊 (Format Badges) -->
            <WrapPanel HorizontalAlignment="Center">
              <Border Style="{StaticResource PillBadgeStyle}" Background="{StaticResource PillBlue}" Margin="0,0,8,6">
                <TextBlock Text="HEIC / HEIF（需系統解碼器）" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
              </Border>
              <Border Style="{StaticResource PillBadgeStyle}" Background="{StaticResource PillMint}" Margin="0,0,8,6">
                <TextBlock Text="WebP（需系統解碼器）" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
              </Border>
              <Border Style="{StaticResource PillBadgeStyle}" Background="{StaticResource PillGold}" Margin="0,0,8,6">
                <TextBlock Text="JPG / JPEG" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
              </Border>
              <Border Style="{StaticResource PillBadgeStyle}" Background="{StaticResource PillLilac}" Margin="0,0,0,6">
                <TextBlock Text="PNG / BMP / TIFF / GIF（限單張）" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
              </Border>
            </WrapPanel>
          </StackPanel>
        </Grid>
        <!-- 任務清單 -->
        <ListView ItemsSource="{Binding Tasks}" Background="Transparent" BorderThickness="0" AlternationCount="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource GameListItemStyle}" Foreground="{StaticResource TextPrimary}">
          <ListView.ItemTemplate>
            <DataTemplate DataType="{x:Type models:ImageTaskItem}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*"/>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="110"/>
                  <ColumnDefinition Width="54"/>
                </Grid.ColumnDefinitions>
                <!-- 檔名與路徑 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                  <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding FilePath}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                </StackPanel>
                <!-- 格式與大小 -->
                <Border Grid.Column="1" Style="{StaticResource PillBadgeStyle}" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding SourceFormat}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentPrimary}"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding SourceSizeFormatted}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" FontSize="12" FontFamily="{StaticResource NumberFont}"/>
                <!-- 進度與狀態 -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                  <ProgressBar Value="{Binding Progress}" Maximum="100" Height="12" Margin="0,0,0,3"/>
                  <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>
                </StackPanel>
                <!-- 輸出大小與耗時 -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
                  <TextBlock Text="{Binding OutputSizeFormatted}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource NumberFont}"/>
                  <TextBlock Text="{Binding Elapsed, StringFormat={}{0:mm\\:ss\\.ff}}" FontSize="12" Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource NumberFont}"/>
                </StackPanel>
                <!-- 刪除項目按鈕 -->
                <Button Grid.Column="5" Content="移除" Command="{Binding DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="從清單移除（不刪除檔案）" Width="48" Height="34" Padding="0" FontSize="12" VerticalAlignment="Center"/>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Success">
                  <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource AccentSuccess}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                  <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource AccentDangerHover}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>
    <!-- 下方轉檔參數設定區 -->
    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="14,8">
      <WrapPanel VerticalAlignment="Center" IsEnabled="{Binding CanEditSettings}">
        <!-- 格式選擇 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,20,3">
          <TextBlock Text="目標格式：" Style="{StaticResource FormLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding TargetFormat}" AutomationProperties.Name="圖片輸出格式" Width="96"/>
        </StackPanel>
        <!-- 品質設定 (JPG時有效) -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,20,3" IsEnabled="{Binding TargetFormat, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=JPG}">
          <TextBlock Text="JPG 品質：" Style="{StaticResource FormLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Slider Value="{Binding JpgQuality}" AutomationProperties.Name="JPG 壓縮品質" Minimum="10" Maximum="100" Width="105" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"/>
          <TextBlock Text="{Binding JpgQuality, StringFormat={}{0}}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontFamily="{StaticResource NumberFont}" Width="40" ToolTip="數值越高，壓縮越少；不是畫質保留百分比" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="13"/>
        </StackPanel>
        <!-- 最大尺寸限制 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,20,3">
          <TextBlock Text="尺寸限制：" Style="{StaticResource FormLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox ItemsSource="{Binding MaxDimensionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MaxDimension}" AutomationProperties.Name="輸出長邊上限" Width="154" ToolTip="等比例縮放長邊上限（不放大原圖）"/>
        </StackPanel>
        <!-- Exif 旋轉校正 -->
        <CheckBox IsChecked="{Binding AutoOrient}" Content="依拍攝資訊校正方向" VerticalAlignment="Center" Margin="0,3,20,3"/>
        <!-- 輸出位置管理 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,3">
          <Button Content="變更儲存位置" Command="{Binding BrowseOutputDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" ToolTip="{Binding OutputDirectoryHint}"/>
          <Button Content="開啟資料夾" Command="{Binding OpenOutputDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="開啟目前設定的儲存資料夾"/>
        </StackPanel>
      </WrapPanel>
    </Border>
    <!-- 底部進度與執行按鈕 -->
    <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="14,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- 總體進度 -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ProgressBar Value="{Binding OverallProgress}" Maximum="100" Height="18" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding OutputDirectoryHint}" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap" ToolTip="{Binding OutputDirectoryHint}"/>
          <TextBlock Text="{Binding IndexMessage}" TextWrapping="Wrap" Margin="0,6,0,4"/>
          <Button Content="重試來源紀錄" Command="{Binding RetryIndexCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/>
        </StackPanel>
        <!-- 啟動 / 取消按鈕 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="停止轉檔" Command="{Binding CancelConvertCommand}" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,8,0" Height="42"/>
          <Button Content="開始轉檔" ToolTip="處理尚未完成及失敗的項目；成功項目不重複轉換" Command="{Binding StartConvertCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="22,0" Height="42" FontSize="14"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
