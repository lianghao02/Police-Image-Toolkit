<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:models="clr-namespace:PoliceImageToolkit.Models" x:Class="PoliceImageToolkit.Views.ImageConverterView" mc:Ignorable="d" d:DesignHeight="650" d:DesignWidth="900" AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
  <Grid Margin="14,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 頂部功能列 -->
    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="圖片批次轉檔" Style="{StaticResource Heading2TextStyle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <TextBlock Grid.Column="1" Text="{Binding Tasks.Count, StringFormat=待處理清單：{0} 張圖片}" Style="{StaticResource HelperTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="加入圖片" Command="{Binding AddFilesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
          <Button Content="加入資料夾" Command="{Binding AddFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
          <Button Content="依設定重轉" Command="{Binding ReconvertCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" ToolTip="將已完成或失敗的圖片依目前設定另存新檔，先前輸出會保留"/>
          <Button Content="移除全部" Command="{Binding ClearAllCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 中間任務列表 / 拖曳提示區 -->
    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="10">
      <Grid>
        <!-- 任務清單（含欄位表頭） -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource BgInset}" CornerRadius="6" Padding="10,6" Margin="0,0,2,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="165"/>
                <ColumnDefinition Width="114"/>
                <ColumnDefinition Width="60"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="預覽" Style="{StaticResource HelperTextStyle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="檔名與來源路徑" Style="{StaticResource HelperTextStyle}" FontWeight="SemiBold" Margin="6,0,10,0"/>
              <TextBlock Grid.Column="2" Text="來源格式" Style="{StaticResource HelperTextStyle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="原大小" Style="{StaticResource HelperTextStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="4" Text="處理進度與狀態" Style="{StaticResource HelperTextStyle}" FontWeight="SemiBold" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="5" Text="輸出大小／耗時" Style="{StaticResource HelperTextStyle}" FontWeight="SemiBold" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="6" Text="操作" Style="{StaticResource HelperTextStyle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </Grid>
          </Border>

          <ListView Grid.Row="1" ItemsSource="{Binding Tasks}" Background="Transparent" BorderThickness="0" AlternationCount="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource GameListItemStyle}" Foreground="{StaticResource TextPrimary}">
            <ListView.ItemTemplate>
              <DataTemplate DataType="{x:Type models:ImageTaskItem}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="114"/>
                    <ColumnDefinition Width="60"/>
                  </Grid.ColumnDefinitions>
                  <!-- 縮圖（點擊預覽） -->
                  <Border Grid.Column="0" Width="38" Height="38" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderColorLight}" BorderThickness="1" CornerRadius="5" ClipToBounds="True" Cursor="Hand" ToolTip="點擊預覽圖片" MouseLeftButtonUp="Thumbnail_MouseLeftButtonUp">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                  </Border>
                  <!-- 檔名與路徑 -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                    <TextBlock Text="{Binding FileName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding FilePath}" Style="{StaticResource HelperTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                  </StackPanel>
                  <!-- 格式與大小 -->
                  <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SourceFormat}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentPrimary}"/>
                  </Border>
                  <TextBlock Grid.Column="3" Text="{Binding SourceSizeFormatted}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" FontSize="12.5" FontFamily="{StaticResource NumberFont}"/>
                  <!-- 進度與狀態 -->
                  <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="10" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>
                  </StackPanel>
                  <!-- 輸出大小與耗時 -->
                  <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding OutputSizeFormatted}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource NumberFont}"/>
                    <TextBlock Text="{Binding Elapsed, StringFormat={}{0:mm\\:ss\\.ff}}" FontSize="12" Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource NumberFont}"/>
                  </StackPanel>
                  <!-- 移除項目按鈕 -->
                  <Button Grid.Column="6" Content="移除" Command="{Binding DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource CompactButtonStyle}" ToolTip="從清單移除（不刪除原始檔案）" Width="52" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Status}" Value="Success">
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource AccentSuccess}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource AccentDangerHover}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>

        <!-- 清單為空時覆蓋顯示拖曳熱區 -->
        <Grid Background="{StaticResource BgCard}" Visibility="{Binding Tasks.Count, Converter={StaticResource CountToVisHiddenConverter}}">
          <Rectangle RadiusX="10" RadiusY="10" Fill="{StaticResource BgInset}" Stroke="{StaticResource BorderColorInput}" StrokeThickness="1.5" StrokeDashArray="5 3" SnapsToDevicePixels="True"/>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <Grid Width="68" Height="68" HorizontalAlignment="Center" Margin="0,0,0,14">
              <Ellipse Fill="{StaticResource GoldChin}" Stroke="{StaticResource BorderColorLight}" StrokeThickness="1" Margin="0,4,0,0"/>
              <Ellipse Fill="{StaticResource GoldFace}" Stroke="{StaticResource BorderColorLight}" StrokeThickness="1" Margin="0,0,0,4"/>
              <TextBlock Text="圖片" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4"/>
            </Grid>
            <TextBlock Text="將圖片或資料夾拖曳至此，或選擇「加入圖片」" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
            <TextBlock Text="設定目標格式與尺寸後按「開始轉檔」，原始檔案一律保留" Style="{StaticResource HelperTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,14"/>
            <WrapPanel HorizontalAlignment="Center">
              <Border Style="{StaticResource PillBadgeStyle}" Background="{StaticResource PillBlue}" Margin="0,0,8,6">
                <TextBlock Text="HEIC / HEIF（需系統解碼器）" FontSize="12" FontWeight="SemiBold"/>
              </Border>
              <Border Style="{StaticResource PillBadgeStyle}" Background="{StaticResource PillMint}" Margin="0,0,8,6">
                <TextBlock Text="WebP（需系統解碼器）" FontSize="12" FontWeight="SemiBold"/>
              </Border>
              <Border Style="{StaticResource PillBadgeStyle}" Background="{StaticResource PillGold}" Margin="0,0,8,6">
                <TextBlock Text="JPG / JPEG" FontSize="12" FontWeight="SemiBold"/>
              </Border>
              <Border Style="{StaticResource PillBadgeStyle}" Background="{StaticResource PillLilac}" Margin="0,0,0,6">
                <TextBlock Text="PNG / BMP / TIFF / GIF（限單張）" FontSize="12" FontWeight="SemiBold"/>
              </Border>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- 下方轉檔參數與儲存位置卡片 -->
    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12,10">
      <StackPanel>
        <WrapPanel VerticalAlignment="Center" IsEnabled="{Binding CanEditSettings}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,20,2">
            <TextBlock Text="目標格式：" Style="{StaticResource FormLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding TargetFormat}" AutomationProperties.Name="圖片輸出格式" Width="96"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,20,2" IsEnabled="{Binding TargetFormat, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=JPG}">
            <TextBlock Text="JPG 品質：" Style="{StaticResource FormLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Slider Value="{Binding JpgQuality}" AutomationProperties.Name="JPG 壓縮品質" Minimum="10" Maximum="100" Width="105" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"/>
            <TextBlock Text="{Binding JpgQuality, StringFormat={}{0}}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontFamily="{StaticResource NumberFont}" Width="36" ToolTip="數值越高，壓縮越少；不是畫質保留百分比" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,20,2">
            <TextBlock Text="尺寸限制：" Style="{StaticResource FormLabelTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding MaxDimensionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MaxDimension}" AutomationProperties.Name="輸出長邊上限" Width="158" ToolTip="等比例縮放長邊上限（不放大原圖）"/>
          </StackPanel>
          <CheckBox IsChecked="{Binding AutoOrient}" Content="依拍攝資訊校正方向" VerticalAlignment="Center" Margin="0,2,0,2"/>
        </WrapPanel>

        <Border BorderBrush="{StaticResource BorderColorLight}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Content="變更儲存位置" Command="{Binding BrowseOutputDirectoryCommand}" Style="{StaticResource CompactButtonStyle}" Height="30" Margin="0,0,6,0"/>
              <Button Content="開啟資料夾" Command="{Binding OpenOutputDirectoryCommand}" Style="{StaticResource CompactButtonStyle}" Height="30"/>
            </StackPanel>
            <TextBlock Text="{Binding OutputDirectoryHint}" Style="{StaticResource HelperTextStyle}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputDirectoryHint}"/>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- 底部進度與執行列 -->
    <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="{Binding SummaryText}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <ProgressBar Value="{Binding OverallProgress}" Maximum="100" Height="12"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasPendingIndexWork, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="{Binding IndexMessage}" Style="{StaticResource HelperTextStyle}" Foreground="{StaticResource AccentDangerHover}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="重試來源紀錄" Command="{Binding RetryIndexCommand}" Style="{StaticResource DangerButtonStyle}" Height="28" FontSize="12.5" Padding="10,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="停止轉檔" Command="{Binding CancelConvertCommand}" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,8,0" Height="40"/>
          <Button Content="開始轉檔" ToolTip="處理尚未完成與失敗的項目；成功項目不重複轉換" Command="{Binding StartConvertCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="136" Height="40" FontSize="14.5"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
