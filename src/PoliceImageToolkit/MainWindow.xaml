<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewModels="clr-namespace:PoliceImageToolkit.ViewModels" xmlns:views="clr-namespace:PoliceImageToolkit.Views" x:Class="PoliceImageToolkit.MainWindow" mc:Ignorable="d" Title="{Binding AppTitle}" Icon="app.ico" Height="900" Width="1280" MinHeight="640" MinWidth="960" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowPatternBrush}" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.ClearTypeHint="Enabled">
  <Window.Resources>
    <!-- 2D 日系動漫頂欄導覽分頁按鈕（立體膠囊硬邊造型） -->
    <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#CFE3FA"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="chin" Background="#0D172B" CornerRadius="8" Margin="0,2,0,0" Visibility="Collapsed"/>
              <Border x:Name="tab" Background="#2B3E63" BorderBrush="#4E6794" BorderThickness="1.5" CornerRadius="8" Margin="0,0,0,2" ClipToBounds="True">
                <Grid>
                  <Border x:Name="shine" Height="3" VerticalAlignment="Top" Background="#48FFFFFF" CornerRadius="5,5,0,0" Margin="1,1,1,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                  <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tab" Property="Background" Value="#354C78"/>
                <Setter TargetName="tab" Property="BorderBrush" Value="#7CC4FA"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="White"/>
                <Setter TargetName="tab" Property="Background" Value="{StaticResource PrimaryFace}"/>
                <Setter TargetName="tab" Property="BorderBrush" Value="White"/>
                <Setter TargetName="tab" Property="BorderThickness" Value="2"/>
                <Setter TargetName="chin" Property="Visibility" Value="Visible"/>
                <Setter TargetName="shine" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="tab" Property="BorderBrush" Value="{StaticResource GoldFace}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 深海墨斜紋幾何頂欄筆刷（方案 A 清新天青點綴） -->
    <LinearGradientBrush x:Key="AnimeHeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,0.35">
      <GradientStop Color="#1B2A4A" Offset="0.00"/>
      <GradientStop Color="#1B2A4A" Offset="0.74"/>
      <GradientStop Color="#243C6B" Offset="0.741"/>
      <GradientStop Color="#243C6B" Offset="0.81"/>
      <GradientStop Color="#1B2A4A" Offset="0.811"/>
      <GradientStop Color="#1B2A4A" Offset="0.845"/>
      <GradientStop Color="#2D8CFF" Offset="0.846"/>
      <GradientStop Color="#2D8CFF" Offset="0.862"/>
      <GradientStop Color="#1B2A4A" Offset="0.863"/>
      <GradientStop Color="#1B2A4A" Offset="1.00"/>
    </LinearGradientBrush>
  </Window.Resources>
  <Window.DataContext>
    <viewModels:MainViewModel/>
  </Window.DataContext>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource AnimeHeaderBackgroundBrush}" BorderBrush="{StaticResource HeaderAccent}" BorderThickness="0,0,0,3" Padding="16,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Border Background="{StaticResource GoldFace}" BorderBrush="{StaticResource Ink}" BorderThickness="1.5" CornerRadius="12" Padding="9,2" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="{Binding CurrentVersionDisplay}" FontFamily="{StaticResource NumberFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
          </Border>
          <Button Content="檢查更新" Command="{Binding CheckUpdateCommand}" Style="{StaticResource HeaderButtonStyle}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" Background="{StaticResource PrimaryFace}" BorderBrush="White" BorderThickness="2" CornerRadius="7" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="PI" FontFamily="{StaticResource NumberFont}" FontSize="12.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Police Image Toolkit" Style="{StaticResource Heading1TextStyle}" FontSize="16.5" Foreground="White"/>
          </StackPanel>
          <Border Width="3" Height="22" Background="{StaticResource HeaderAccent}" CornerRadius="1.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <RadioButton x:Name="TabImage" Content="圖片轉檔" IsChecked="True" GroupName="NavTabs" Checked="TabImage_Checked" Style="{StaticResource NavRadioButtonStyle}"/>
          <RadioButton x:Name="TabVideo" Content="手機錄影截圖" GroupName="NavTabs" Checked="TabVideo_Checked" Style="{StaticResource NavRadioButtonStyle}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <views:ImageConverterView x:Name="ViewImageConverter" DataContext="{Binding ImageConverter}" Visibility="Visible"/>
      <views:VideoSnapshotView x:Name="ViewVideoSnapshot" DataContext="{Binding VideoSnapshot}" Visibility="Collapsed" Focusable="True"/>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource FooterBg}" BorderBrush="{StaticResource InkSoft}" BorderThickness="0,1.5,0,0" Padding="18,6">
      <TextBlock Text="所有處理皆於本機執行 · 衍生圖片不覆寫原始檔案 · 僅手動檢查更新時連線" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
