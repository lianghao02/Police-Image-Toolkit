<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewModels="clr-namespace:PoliceImageToolkit.ViewModels" xmlns:views="clr-namespace:PoliceImageToolkit.Views" x:Class="PoliceImageToolkit.MainWindow" mc:Ignorable="d" Title="{Binding AppTitle}" Icon="app.ico" Height="900" Width="1280" MinHeight="640" MinWidth="960" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowPatternBrush}" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.ClearTypeHint="Enabled">
  <Window.Resources>
    <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="tab" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter TargetName="tab" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tab" Property="Background" Value="{StaticResource BgInset}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="tab" Property="Background" Value="{StaticResource RowSelected}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Window.DataContext>
    <viewModels:MainViewModel/>
  </Window.DataContext>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColorLight}" BorderThickness="0,0,0,1" Padding="18,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="{Binding CurrentVersionDisplay}" Style="{StaticResource HelperTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Button Content="檢查更新" Command="{Binding CheckUpdateCommand}" Style="{StaticResource CompactButtonStyle}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center" Margin="0,8,18,8">
            <TextBlock Text="Police Image Toolkit" Style="{StaticResource Heading1TextStyle}" FontSize="17"/>
          </StackPanel>
          <Border Width="1" Height="22" Background="{StaticResource BorderColorLight}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <RadioButton x:Name="TabImage" Content="圖片轉檔" IsChecked="True" GroupName="NavTabs" Checked="TabImage_Checked" Style="{StaticResource NavRadioButtonStyle}"/>
          <RadioButton x:Name="TabVideo" Content="手機錄影截圖" GroupName="NavTabs" Checked="TabVideo_Checked" Style="{StaticResource NavRadioButtonStyle}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <views:ImageConverterView x:Name="ViewImageConverter" DataContext="{Binding ImageConverter}" Visibility="Visible"/>
      <views:VideoSnapshotView x:Name="ViewVideoSnapshot" DataContext="{Binding VideoSnapshot}" Visibility="Collapsed" Focusable="True"/>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderColorLight}" BorderThickness="0,1,0,0" Padding="18,6">
      <TextBlock Text="所有處理皆於本機執行 · 衍生圖片不覆寫原始檔案 · 僅手動檢查更新時連線" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
