<Window x:Class="PoliceImageToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:PoliceImageToolkit.ViewModels"
        xmlns:views="clr-namespace:PoliceImageToolkit.Views"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        Icon="app.ico"
        Height="800" Width="1180"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowPatternBrush}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- 遊戲分頁籤：未選取為藍底白字，選取為金色厚底按鍵 -->
        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="root" SnapsToDevicePixels="True">
                            <Border x:Name="chin" CornerRadius="11" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"/>
                            <Border x:Name="face" CornerRadius="11" Margin="0,0,0,4" Background="Transparent" BorderBrush="Transparent" BorderThickness="2">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="#2F6BDB"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="#FFC93C"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="chin" Property="Background" Value="{StaticResource GoldChin}"/>
                                <Setter TargetName="chin" Property="BorderBrush" Value="{StaticResource Ink}"/>
                                <Setter TargetName="face" Property="Background" Value="{StaticResource GoldFace}"/>
                                <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 頂部 HUD 標題列 -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,4" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 軟體 Logo（圓形徽章）與標題 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource GoldFace}"
                            BorderBrush="{StaticResource Ink}" BorderThickness="2.5" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" ClipToBounds="True" BorderBrush="{StaticResource Ink}" BorderThickness="1.5">
                            <Border.Background>
                                <ImageBrush ImageSource="app_icon.png" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Police-Image-Toolkit" Style="{StaticResource Heading1TextStyle}" Foreground="White" FontSize="17"/>
                        <TextBlock Text="警務手機影像轉檔與逐格截圖系統" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </StackPanel>

                <!-- 導航分頁籤（深藍凹槽托盤） -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"
                        Background="#173B87" CornerRadius="15" Padding="5,5,5,3" BorderBrush="{StaticResource Ink}" BorderThickness="2.5">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabImage" Content="📁 手機圖片批次轉檔" IsChecked="True"
                                     GroupName="NavTabs" Checked="TabImage_Checked"
                                     Style="{StaticResource NavRadioButtonStyle}" Margin="0,0,4,0"/>

                        <RadioButton x:Name="TabVideo" Content="🎬 手機影片逐格截圖"
                                     GroupName="NavTabs" Checked="TabVideo_Checked"
                                     Style="{StaticResource NavRadioButtonStyle}"/>
                    </StackPanel>
                </Border>

                <!-- 右側版本徽章與檢查更新按鈕 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Ink}" BorderThickness="2,2,2,3"
                            CornerRadius="12" Padding="10,3" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="目前安裝版本 (version.txt)">
                        <TextBlock Text="{Binding CurrentVersionDisplay}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimary}" FontFamily="{StaticResource NumberFont}" VerticalAlignment="Center"/>
                    </Border>

                    <Button Content="🔄 檢查更新" Command="{Binding CheckUpdateCommand}" Style="{StaticResource GoldButtonStyle}"
                            Padding="10,0" Height="34" FontSize="12" VerticalAlignment="Center" ToolTip="連線 GitHub Release 檢查是否有新版本"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主體內容區 (切換 View) -->
        <Grid Grid.Row="1">
            <views:ImageConverterView x:Name="ViewImageConverter" DataContext="{Binding ImageConverter}" Visibility="Visible"/>
            <views:VideoSnapshotView x:Name="ViewVideoSnapshot" DataContext="{Binding VideoSnapshot}" Visibility="Collapsed"/>        </Grid>

        <!-- 底部系統狀態列（深墨底奶油字） -->
        <Border Grid.Row="2" Background="{StaticResource Ink}" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="#2BB765" Stroke="{StaticResource TextOnDark}" StrokeThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="本機處理 100% 離線執行 | 嚴禁以衍生圖檔取代原始司法證物" FontSize="12" Foreground="{StaticResource TextOnDark}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Police-Image-Toolkit Desktop Edition" FontSize="12" Foreground="{StaticResource TextOnDarkSecondary}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
