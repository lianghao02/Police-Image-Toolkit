<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewModels="clr-namespace:PoliceImageToolkit.ViewModels" xmlns:views="clr-namespace:PoliceImageToolkit.Views" x:Class="PoliceImageToolkit.MainWindow" mc:Ignorable="d" Title="{Binding AppTitle}" Icon="app.ico" Height="900" Width="1280" MinHeight="640" MinWidth="960" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowPatternBrush}" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.ClearTypeHint="Enabled">
  <Window.Resources>
    <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="tab" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
                <Setter TargetName="tab" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tab" Property="Background" Value="{StaticResource BgInset}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="tab" Property="Background" Value="{StaticResource RowSelected}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Window.DataContext>
    <viewModels:MainViewModel/>
  </Window.DataContext>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{StaticResource BorderColorLight}" BorderThickness="0,0,0,1" Padding="20,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding CurrentVersionDisplay}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button Content="檢查更新" Command="{Binding CheckUpdateCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Police Image Toolkit" Style="{StaticResource Heading1TextStyle}"/>
          <TextBlock Text="手機圖片轉檔與錄影截圖" Style="{StaticResource HelperTextStyle}" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderColorLight}" BorderThickness="0,0,0,1" Padding="16,0">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="TabImage" Content="圖片轉檔" IsChecked="True" GroupName="NavTabs" Checked="TabImage_Checked" Style="{StaticResource NavRadioButtonStyle}"/>
        <RadioButton x:Name="TabVideo" Content="手機錄影截圖" GroupName="NavTabs" Checked="TabVideo_Checked" Style="{StaticResource NavRadioButtonStyle}"/>
      </StackPanel>
    </Border>
    <ScrollViewer x:Name="WorkspaceScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <Grid MinHeight="640" MinWidth="900" Height="{Binding ElementName=WorkspaceScroll, Path=ViewportHeight}">
        <views:ImageConverterView x:Name="ViewImageConverter" DataContext="{Binding ImageConverter}" Visibility="Visible" MinHeight="640"/>
        <views:VideoSnapshotView x:Name="ViewVideoSnapshot" DataContext="{Binding VideoSnapshot}" Visibility="Collapsed" MinHeight="640"/>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderColorLight}" BorderThickness="0,1,0,0" Padding="20,8">
      <TextBlock Text="影像於本機處理 · 衍生圖片不能取代原始檔案 · 僅手動檢查更新時連線" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="12"/>
    </Border>
  </Grid>
</Window>
