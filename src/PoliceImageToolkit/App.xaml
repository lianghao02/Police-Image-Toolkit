<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PoliceImageToolkit" x:Class="PoliceImageToolkit.App" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
    <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
    <local:CountToVisibilityHiddenConverter x:Key="CountToVisHiddenConverter"/>
    <local:NullToVisibilityConverter x:Key="NullToVisConverter"/>
    <local:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisConverter"/>
    <local:StringEqualsToBoolConverter x:Key="StringEqualsToBoolConverter"/>
    <local:FileNameFromPathConverter x:Key="FileNameFromPathConverter"/>
    <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConverter"/>

    <!-- 2D 日系動漫風格（方案 A 清新天青藍白 × 方案 C 硬邊立體按壓按鈕） -->
    <Color x:Key="InkColor">#1B2A4A</Color>
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="InkSoft" Color="#243656"/>
    <SolidColorBrush x:Key="BgPrimary" Color="#E6F0FA"/>
    <SolidColorBrush x:Key="BgSecondary" Color="#D8E7F6"/>
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgInput" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgInset" Color="#EEF5FC"/>
    <SolidColorBrush x:Key="FooterBg" Color="#DCEAF8"/>
    <SolidColorBrush x:Key="BorderColor" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="BorderColorLight" Color="#B5CBE4"/>
    <SolidColorBrush x:Key="BorderColorInput" Color="#243656"/>
    <SolidColorBrush x:Key="BorderColorFocus" Color="#2D8CFF"/>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#4A5F7F"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6D81A0"/>
    <SolidColorBrush x:Key="TextOnDark" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnDarkSecondary" Color="#CFE3FA"/>
    <SolidColorBrush x:Key="AccentPrimary" Color="#2D8CFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1658B8"/>
    <SolidColorBrush x:Key="AccentSuccess" Color="#24B47E"/>
    <SolidColorBrush x:Key="AccentSuccessHover" Color="#146E4B"/>
    <SolidColorBrush x:Key="AccentDanger" Color="#F2546B"/>
    <SolidColorBrush x:Key="AccentDangerHover" Color="#C4253D"/>
    <SolidColorBrush x:Key="HeaderAccent" Color="#38BDF8"/>
    <SolidColorBrush x:Key="PrimaryFace" Color="#2D8CFF"/>
    <SolidColorBrush x:Key="PrimaryChin" Color="#1B2A4A"/>
    <SolidColorBrush x:Key="SuccessFace" Color="#24B47E"/>
    <SolidColorBrush x:Key="SuccessChin" Color="#1B2A4A"/>
    <SolidColorBrush x:Key="DangerFace" Color="#F2546B"/>
    <SolidColorBrush x:Key="DangerChin" Color="#1B2A4A"/>
    <SolidColorBrush x:Key="SecondaryFace" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryChin" Color="#9EB8D8"/>
    <SolidColorBrush x:Key="GoldFace" Color="#FFC83D"/>
    <SolidColorBrush x:Key="GoldChin" Color="#1B2A4A"/>
    <SolidColorBrush x:Key="DisabledBg" Color="#DCE7F3"/>
    <SolidColorBrush x:Key="DisabledBorder" Color="#B5CBE4"/>
    <SolidColorBrush x:Key="DisabledFg" Color="#7C91AE"/>
    <SolidColorBrush x:Key="RowBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RowZebra" Color="#F3F8FE"/>
    <SolidColorBrush x:Key="RowSelected" Color="#D8ECFF"/>
    <SolidColorBrush x:Key="TrackBackground" Color="#E2EEF9"/>
    <SolidColorBrush x:Key="PillBlue" Color="#D6EBFF"/>
    <SolidColorBrush x:Key="PillMint" Color="#D4F7E6"/>
    <SolidColorBrush x:Key="PillLilac" Color="#EAEFF8"/>
    <SolidColorBrush x:Key="PillGold" Color="#FFC83D"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#A6BFE0"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#6F95C9"/>
    <SolidColorBrush x:Key="ScrollThumbDrag" Color="#2D8CFF"/>
    <SolidColorBrush x:Key="PhoneFrameColor" Color="#1B2A4A"/>
    <SolidColorBrush x:Key="PhoneScreenColor" Color="#0F172A"/>
    <SolidColorBrush x:Key="CompareFrameColor" Color="#2B3E63"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#1B2A4A"/>

    <!-- 清新冰霧藍細點網格畫布 -->
    <DrawingBrush x:Key="WindowPatternBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#E6F0FA">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="0,0,16,16"/>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#C5DAEE">
            <GeometryDrawing.Geometry>
              <EllipseGeometry Center="8,8" RadiusX="1" RadiusY="1"/>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 2D 動漫斜紋進度條填充筆刷 -->
    <DrawingBrush x:Key="AnimeProgressFillBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#2D8CFF">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="0,0,16,16"/>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#52A4FF">
            <GeometryDrawing.Geometry>
              <PathGeometry Figures="M-4,16 L8,0 L14,0 L2,16 Z M12,16 L24,0 L30,0 L18,16 Z"/>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <FontFamily x:Key="AppFont">Microsoft JhengHei UI, Microsoft JhengHei, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="NumberFont">Consolas, Microsoft JhengHei UI, Segoe UI</FontFamily>

    <Style x:Key="Heading1TextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style x:Key="Heading2TextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style x:Key="Heading3TextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style x:Key="FormLabelTextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style x:Key="HelperTextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="CardTitleBadgeStyle" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,2"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="PillBadgeStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PillBlue}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="9,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource TextOnDark}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{StaticResource Ink}" BorderBrush="{StaticResource BorderColorLight}" BorderThickness="1" CornerRadius="6" Padding="10,6" SnapsToDevicePixels="True" TextElement.Foreground="{StaticResource TextOnDark}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="{StaticResource BgInput}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderColorInput}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SelectionBrush" Value="#2D8CFF"/>
      <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="#F6FAFF"/>
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderColorFocus}"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="Validation.HasError" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentDanger}"/>
                <Setter TargetName="border" Property="Background" Value="#FFF0F2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisabledBg}"/>
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DisabledBorder}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledFg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Validation.ErrorTemplate">
        <Setter.Value>
          <ControlTemplate>
            <AdornedElementPlaceholder/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="0,1" SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgInset}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderColorFocus}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource RowSelected}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="{StaticResource BgInput}"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
              <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderColorInput}" BorderThickness="1.5" CornerRadius="7">
                      <Border HorizontalAlignment="Right" Width="28" Background="{StaticResource BgInset}" BorderBrush="{StaticResource BorderColorLight}" BorderThickness="1.5,0,0,0" CornerRadius="0,5,5,0">
                        <Path Data="M0,0 L8,0 L4,4.5 Z" Fill="{StaticResource AccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="#F6FAFF"/>
                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderColorFocus}"/>
                        <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColorInput}" BorderThickness="1" CornerRadius="6" Margin="0,3,0,0" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer SnapsToDevicePixels="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="20" Height="20" CornerRadius="5" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderColorInput}" BorderThickness="2" VerticalAlignment="Center" SnapsToDevicePixels="True">
                <Path x:Name="check" Data="M2.5,7.5 L6,11 L12.5,3.5" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource RowZebra}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource BorderColorFocus}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource PrimaryFace}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ink}"/>
                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource BorderColorFocus}"/>
                <Setter TargetName="box" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledFg}"/>
                <Setter TargetName="box" Property="Background" Value="{StaticResource DisabledBg}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource DisabledBorder}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SliderFillRepeatButtonStyle" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Height="10" Background="{StaticResource PrimaryFace}" BorderBrush="{StaticResource Ink}" BorderThickness="2,2,0,2" CornerRadius="5,0,0,5" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderEmptyRepeatButtonStyle" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GameSliderThumbStyle" TargetType="Thumb">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid SnapsToDevicePixels="True">
              <Ellipse Fill="{StaticResource Ink}" Margin="0,2,0,-2" Opacity="0.85"/>
              <Ellipse x:Name="coin" Fill="{StaticResource GoldFace}" Stroke="{StaticResource Ink}" StrokeThickness="2"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="coin" Property="Fill" Value="#FFE07D"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="coin" Property="Fill" Value="{StaticResource PrimaryFace}"/>
                <Setter TargetName="coin" Property="Stroke" Value="{StaticResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center" Background="Transparent">
              <Border Height="10" Background="{StaticResource TrackBackground}" BorderBrush="{StaticResource Ink}" BorderThickness="2" CornerRadius="5" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillRepeatButtonStyle}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyRepeatButtonStyle}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource GameSliderThumbStyle}"/>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="thumb" Background="{StaticResource ScrollThumb}" CornerRadius="4"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="thumb" Property="Background" Value="{StaticResource ScrollThumbHover}"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="thumb" Property="Background" Value="{StaticResource ScrollThumbDrag}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="Transparent" CornerRadius="4">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumbStyle}" MinHeight="24"/>
                </Track.Thumb>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="MinHeight" Value="10"/>
          <Setter Property="Margin" Value="0,2,0,0"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Border Background="Transparent" CornerRadius="4">
                  <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumbStyle}" MinWidth="24"/>
                    </Track.Thumb>
                  </Track>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 2D 日系動漫硬邊立體按壓按鈕模板（2px 深墨外框 + 頂部高光條 + 3px 實色硬陰影，按下下沉壓實） -->
    <ControlTemplate x:Key="ChunkyButtonTemplate" TargetType="Button">
      <Grid SnapsToDevicePixels="True">
        <Border x:Name="chin" Background="{TemplateBinding BorderBrush}" CornerRadius="8" Margin="0,3,0,0"/>
        <Border x:Name="face" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Ink}" BorderThickness="2" CornerRadius="8" Margin="0,0,0,3" ClipToBounds="True">
          <Grid>
            <Border x:Name="shine" Height="4" VerticalAlignment="Top" Background="#58FFFFFF" CornerRadius="5,5,0,0" Margin="1,1,1,0" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="shine" Property="Background" Value="#88FFFFFF"/>
          <Setter TargetName="face" Property="Margin" Value="0,1,0,2"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="face" Property="Margin" Value="0,3,0,0"/>
          <Setter TargetName="shine" Property="Background" Value="#25FFFFFF"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource HeaderAccent}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource DisabledBorder}"/>
          <Setter TargetName="chin" Property="Background" Value="{StaticResource DisabledBorder}"/>
          <Setter TargetName="shine" Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 頂欄專屬硬邊按鈕模板（天青框線適配深海墨頂欄） -->
    <ControlTemplate x:Key="HeaderAnimeButtonTemplate" TargetType="Button">
      <Grid SnapsToDevicePixels="True">
        <Border x:Name="chin" Background="#0D172B" CornerRadius="7" Margin="0,2,0,0"/>
        <Border x:Name="face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="7" Margin="0,0,0,2" ClipToBounds="True">
          <Grid>
            <Border x:Name="shine" Height="3" VerticalAlignment="Top" Background="#45FFFFFF" CornerRadius="5,5,0,0" Margin="1,1,1,0" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="face" Property="Background" Value="{StaticResource PrimaryFace}"/>
          <Setter TargetName="face" Property="Margin" Value="0,1,0,1"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="face" Property="Margin" Value="0,2,0,0"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 緊湊警示按鈕模板（列表刪除／移除專用，維持柔粉底＋珊瑚紅邊） -->
    <ControlTemplate x:Key="CompactDangerButtonTemplate" TargetType="Button">
      <Grid SnapsToDevicePixels="True">
        <Border x:Name="chin" Background="#F5B7C1" CornerRadius="6" Margin="0,2,0,0"/>
        <Border x:Name="face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="6" Margin="0,0,0,2">
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="face" Property="Background" Value="#FFD6DD"/>
          <Setter TargetName="face" Property="Margin" Value="0,1,0,1"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="face" Property="Margin" Value="0,2,0,0"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="face" Property="Background" Value="{StaticResource DisabledBg}"/>
          <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource DisabledBorder}"/>
          <Setter TargetName="chin" Property="Background" Value="{StaticResource DisabledBorder}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource PrimaryFace}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryChin}"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="37"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      <Setter Property="Template" Value="{StaticResource ChunkyButtonTemplate}"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="{StaticResource DisabledBg}"/>
          <Setter Property="BorderBrush" Value="{StaticResource DisabledBorder}"/>
          <Setter Property="Foreground" Value="{StaticResource DisabledFg}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
      <Setter Property="Background" Value="{StaticResource SuccessFace}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SuccessChin}"/>
    </Style>
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
      <Setter Property="Background" Value="{StaticResource DangerFace}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DangerChin}"/>
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="{StaticResource SecondaryFace}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SecondaryChin}"/>
    </Style>
    <Style x:Key="GoldButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Background" Value="{StaticResource GoldFace}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GoldChin}"/>
    </Style>
    <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#1658B8"/>
      <Setter Property="BorderBrush" Value="#38BDF8"/>
      <Setter Property="Template" Value="{StaticResource HeaderAnimeButtonTemplate}"/>
    </Style>
    <Style x:Key="CompactDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
      <Setter Property="Foreground" Value="#C4253D"/>
      <Setter Property="Background" Value="#FFE7EB"/>
      <Setter Property="BorderBrush" Value="#F2546B"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Template" Value="{StaticResource CompactDangerButtonTemplate}"/>
    </Style>

    <Style x:Key="SegmentedRadioStyle" TargetType="RadioButton">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="pill" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderColorLight}" BorderThickness="1.5" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="pill" Property="Background" Value="{StaticResource PillBlue}"/>
                <Setter TargetName="pill" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="pill" Property="Background" Value="{StaticResource PrimaryFace}"/>
                <Setter TargetName="pill" Property="BorderBrush" Value="{StaticResource Ink}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 卡片採純向量不對稱硬邊（保留 100% 銳利 ClearType 字體、同時呈現 2D 動漫厚實底邊） -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource BgCard}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InkSoft}"/>
      <Setter Property="BorderThickness" Value="1.5,1.5,2.5,3.5"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="GameListItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="{StaticResource RowBackground}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderColorLight}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,0,2,4"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderColorFocus}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderColorFocus}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource RowSelected}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderColorFocus}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
          <Setter Property="Background" Value="{StaticResource RowZebra}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource AnimeProgressFillBrush}"/>
      <Setter Property="Background" Value="{StaticResource TrackBackground}"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Ink}" BorderThickness="2" CornerRadius="7" SnapsToDevicePixels="True">
              <Grid x:Name="PART_Track" Margin="1">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="5"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
